# Omnichannel Growth Suite Configuration

# 1. Google Gemini API Key (Required for AI Takes & Sentiment Analysis)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Creator positioning (no product branding, no links in post bodies)
CREATOR_NAME=Vishnu
CREATOR_NICHE=AI engineering, LLM benchmarks, developer tools and builder culture
CREATOR_BIO=AI engineering, LLM benchmarks and developer tooling. Building in public.
CREATOR_HEADLINE=AI engineering, LLM benchmarks & developer tooling | Building in public
CREATOR_LOCATION=Remote
# External links in post bodies suppress reach on X and LinkedIn. Keep this false.
ALLOW_LINKS_IN_POSTS=false

# 3. Automation Strategy (one post every ~6 hours on X and Bluesky)
POSTS_PER_DAY=4
REPLY_PERCENTAGE=75
POST_INTERVAL_MIN_MINUTES=350
POST_INTERVAL_MAX_MINUTES=370

# 4. High-Traction Niches (Comma-separated)
TARGET_NICHES=ai_tech,wealth_finance,viral_culture,work_life_debates

# 5. Omnichannel: Bluesky (AT Protocol - 100% Free)
# Set your Bluesky handle and an App Password (Settings -> App Passwords)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 6. Omnichannel: LinkedIn
LINKEDIN_ENABLED=true
# LinkedIn is intentionally capped at 1 post/day. More than that suppresses reach.
MAX_DAILY_LINKEDIN=1
LINKEDIN_MIN_INTERVAL_MINUTES=720
# Attach the sharper static PNG instead of the looping GIF for architecture diagrams
LINKEDIN_PREFER_STATIC_VISUALS=true
# Allows a scheduled run to start after a long media/API call while still blocking bursts.
LINKEDIN_SCHEDULE_GRACE_MINUTES=60
# Viral engagement cap: comments + replies on others' posts per day
MAX_DAILY_LINKEDIN_PEER_COMMENTS=6
# Current LinkedIn Marketing API version (YYYYMM); update before the version is sunset.
LINKEDIN_API_VERSION=202610
