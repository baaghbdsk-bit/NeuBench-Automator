# NeuBench-Automator Configuration

# 1. Google Gemini API Key (Required for AI Takes & Sentiment Analysis)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Automation Strategy
POSTS_PER_DAY=18
REPLY_PERCENTAGE=75
POST_INTERVAL_MIN_MINUTES=35
POST_INTERVAL_MAX_MINUTES=75

# 3. High-Traction Niches (Comma-separated)
TARGET_NICHES=ai_tech,wealth_finance,viral_culture,work_life_debates

# 4. Omnichannel: Bluesky (AT Protocol - 100% Free)
# Set your Bluesky handle and an App Password (Settings -> App Passwords)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 5. Omnichannel: LinkedIn & Threads
LINKEDIN_ENABLED=true
THREADS_ENABLED=true
